defmodule <%= @billing_context %> do
  @moduledoc """
  Host-owned billing facade generated by `mix accrue.install`.

  Keep host policy hooks here and leave processor normalization to Accrue.
  """

  alias Accrue.Billing

  # Host policy hook: authorize who may subscribe this billable.
  def subscribe(billable, price_id, opts \\ []) do
    Billing.subscribe(billable, price_id, opts)
  end

  # Host policy hook: enforce plan-change rules before delegating.
  def swap_plan(subscription, price_id, opts) do
    Billing.swap_plan(subscription, price_id, opts)
  end

  # Host policy hook: present the shared preview-before-commit contract without
  # teaching UI code to assemble preview opts on its own.
  def preview_plan_change(subscription, price_id, opts \\ [proration: :create_prorations]) do
    Billing.preview_upcoming_invoice(
      subscription,
      Keyword.put(opts, :new_price_id, price_id)
    )
  end

  # Host policy hook: keep the actual commit path explicit and adjacent to the
  # preview helper.
  def change_plan(subscription, price_id, opts \\ [proration: :create_prorations]) do
    Billing.swap_plan(subscription, price_id, opts)
  end

  # Host policy hook: decide immediate cancellation vs grace-period flows.
  def cancel(subscription, opts \\ []) do
    Billing.cancel(subscription, opts)
  end

  # Host policy hook: preload or scope billable ownership if needed.
  def customer_for(billable) do
    Billing.customer(billable)
  end

  # Optional Portal policy hook. Keep the generated default self-only; hosts
  # that bill organizations should resolve membership in their own adapter.
  def portal_organization_for(_actor, _organization_id), do: {:error, :unavailable}

  def authorize_portal_action(actor, billable, customer, action, target)
      when actor == billable and
             action in [
               :read,
               :payment_method_create,
               :payment_method_default,
               :payment_method_delete,
               :subscription_cancel,
               :subscription_change,
               :subscription_preview,
               :checkout_validate_promo,
               :checkout_complete
             ] do
    if target == billable or target == customer or customer_target?(customer, target) do
      :ok
    else
      {:error, :forbidden}
    end
  end

  def authorize_portal_action(_actor, _billable, _customer, _action, _target),
    do: {:error, :forbidden}

  defp customer_target?(%{id: id}, %{customer_id: id}), do: true
  defp customer_target?(_, _), do: false

  # Host policy hook: resolve the billable boundary before delegating the
  # shared customer-update contract to Accrue.
  def update_customer(billable, attrs) when is_map(attrs) do
    with {:ok, customer} <- customer_for(billable) do
      Billing.update_customer(customer, attrs)
    end
  end

  # Host may add policy, preloads, or presentation mapping before delegating.
  @doc false
  def list_payment_methods(customer, opts \\ []) do
    Billing.list_payment_methods(customer, opts)
  end

  @doc false
  def list_payment_methods!(customer, opts \\ []) do
    Billing.list_payment_methods!(customer, opts)
  end
end

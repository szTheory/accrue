        },
        {
          "marker": "generated guide preserves Phase 253 compiled routes",
          "path": "accrue_admin/test/accrue_admin/dev/subscription_manifest_test.exs"
        }
      ],
      "id": "AMD-254-01",
      "original": "D-06/D-14 pin the full-mode browser counts as the literals 15 Phase 252 cells (12 canonical, 3 compatibility) and 151 Phase 253 cells.",
      "owner_ack": {
        "date": "2026-10-28",
        "status": "owner-accepted at plan time"
      },
      "rationale": "D-39 locks that the pinned literals are derived from the ledger as an explicit amendment; keeping 15 as a literal would make the D-40 duplicate retirement impossible without weakening a gate, while deriving the count keeps every skip, retry and flaky rejection and the 12 canonical cells intact."
    }

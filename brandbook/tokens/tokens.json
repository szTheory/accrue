{
  "$schema": "https://tr.designtokens.org/format/tokens.schema.json",
  "color": {
    "$type": "color",
    "brand": {
      "ink": {
        "$value": { "colorSpace": "srgb", "components": [0.067, 0.078, 0.094], "hex": "#111418" },
        "$type": "color",
        "$description": "Ink — primary text, dark surface baseline. AAA on Paper and Fog.",
        "$extensions": { "org.accrue.ax": { "axMap": "--ax-primary" } }
      },
      "slate": {
        "$value": { "colorSpace": "srgb", "components": [0.141, 0.188, 0.231], "hex": "#24303b" },
        "$type": "color",
        "$description": "Slate — secondary dark, borders, subtext on light surfaces. AAA on Paper.",
        "$extensions": { "org.accrue.ax": { "axMap": "--ax-subtle" } }
      },
      "fog": {
        "$value": { "colorSpace": "srgb", "components": [0.914, 0.933, 0.949], "hex": "#e9eef2" },
        "$type": "color",
        "$description": "Fog — soft neutral light, section backgrounds. Brand-only: no current --ax-* semantic binding.",
        "$extensions": { "org.accrue.ax": { "axMap": null } }
      },
      "paper": {
        "$value": { "colorSpace": "srgb", "components": [0.980, 0.984, 0.988], "hex": "#fafbfc" },
        "$type": "color",
        "$description": "Paper — document background, page base.",
        "$extensions": { "org.accrue.ax": { "axMap": "--ax-base" } }
      },
      "moss": {
        "$value": { "colorSpace": "srgb", "components": [0.369, 0.620, 0.518], "hex": "#5e9e84" },
        "$type": "color",
        "$description": "Moss — success/active states, icons, large-text accent on light. AA-large only on Paper (3.03:1); FAIL AA-body on light surfaces.",
        "$extensions": { "org.accrue.ax": { "axMap": "--ax-success" } }
      },
      "cobalt": {
        "$value": { "colorSpace": "srgb", "components": [0.365, 0.475, 0.965], "hex": "#5d79f6" },
        "$type": "color",
        "$description": "Cobalt — interactive/link states, focus rings. Brand-only: no current --ax-* semantic binding (consumed by host as --ax-accent). AA-large only on Paper (3.66:1).",
        "$extensions": { "org.accrue.ax": { "axMap": null } }
      },
      "amber": {
        "$value": { "colorSpace": "srgb", "components": [0.784, 0.573, 0.231], "hex": "#c8923b" },
        "$type": "color",
        "$description": "Amber — warning/pending states. FAIL AA-large on Paper (2.66:1); restricted to icons, decorative borders, text on Ink-surface backgrounds.",
        "$extensions": { "org.accrue.ax": { "axMap": "--ax-warning" } }
      }
    },
    "surface": {
      "$type": "color",
      "$description": "Surface semantic roles — base, elevated, sunken page surfaces.",
      "base": {
        "$value": "{color.brand.paper}",
        "$type": "color",
        "$description": "Base page surface — equals Paper (#fafbfc).",
        "$extensions": { "org.accrue.ax": { "axMap": "--ax-base" } }
      },
      "elevated": {
        "$value": { "colorSpace": "srgb", "components": [1.0, 1.0, 1.0], "hex": "#ffffff" },
        "$type": "color",
        "$description": "Elevated surface — cards, modals, raised panels.",
        "$extensions": { "org.accrue.ax": { "axMap": "--ax-elevated" } }
      },
      "sunken": {
        "$value": { "colorSpace": "srgb", "components": [0.945, 0.961, 0.973], "hex": "#f1f5f8" },
        "$type": "color",
        "$description": "Sunken surface — table backgrounds, recessed wells.",
        "$extensions": { "org.accrue.ax": { "axMap": "--ax-sunken" } }
      }
    },
    "content": {
      "$type": "color",
      "$description": "Content semantic roles — text and icon colors.",
      "primary": {
        "$value": "{color.brand.ink}",
        "$type": "color",
        "$description": "Primary content — headings, body text, default foreground.",
        "$extensions": { "org.accrue.ax": { "axMap": "--ax-primary" } }
      },
      "muted": {
        "$value": { "colorSpace": "srgb", "components": [0.365, 0.416, 0.451], "hex": "#5d6a73" },
        "$type": "color",
        "$description": "Muted content — secondary labels, captions, placeholders.",
        "$extensions": { "org.accrue.ax": { "axMap": "--ax-muted" } }
      },
      "subtle": {
        "$value": "{color.brand.slate}",
        "$type": "color",
        "$description": "Subtle content — borders, dividers, tertiary UI elements.",
        "$extensions": { "org.accrue.ax": { "axMap": "--ax-subtle" } }
      }
    },
    "interactive": {
      "$type": "color",
      "$description": "Interactive semantic roles — accent and focus states.",
      "accent": {
        "$value": "{color.brand.cobalt}",
        "$type": "color",
        "$description": "Interactive accent — buttons, links, active states. Brand-only: --ax-accent is set by the host app to this value; no flat --ax-accent in theme.css.",
        "$extensions": { "org.accrue.ax": { "axMap": null } }
      },
      "focus-ring": {
        "$value": { "colorSpace": "srgb", "components": [0.365, 0.475, 0.965], "hex": "#5d79f6" },
        "$type": "color",
        "$description": "Focus ring — 2px solid Cobalt focus ring, 2px offset (WCAG 2.4.11 compliant; BRAND-AUDIT §7 item 6). Admin --ax-focus-ring is a color-mix(in oklch, var(--ax-accent) 70%, white) — not value-checked.",
        "$extensions": { "org.accrue.ax": { "axMap": null } }
      }
    },
    "feedback": {
      "$type": "color",
      "$description": "Feedback semantic roles — success, warning, danger, info.",
      "success": {
        "$value": "{color.brand.moss}",
        "$type": "color",
        "$description": "Success — equals Moss (#5e9e84).",
        "$extensions": { "org.accrue.ax": { "axMap": "--ax-success" } }
      },
      "warning": {
        "$value": "{color.brand.amber}",
        "$type": "color",
        "$description": "Warning — equals Amber (#c8923b).",
        "$extensions": { "org.accrue.ax": { "axMap": "--ax-warning" } }
      },
      "danger": {
        "$value": { "colorSpace": "srgb", "components": [0.839, 0.294, 0.294], "hex": "#d64b4b" },
        "$type": "color",
        "$description": "Danger — destructive actions, error states.",
        "$extensions": { "org.accrue.ax": { "axMap": "--ax-danger" } }
      },
      "info": {
        "$value": { "colorSpace": "srgb", "components": [0.220, 0.471, 0.651], "hex": "#3878a6" },
        "$type": "color",
        "$description": "Info — calm teal-blue for informational states; distinct from accent to avoid confusion with interactive surfaces.",
        "$extensions": { "org.accrue.ax": { "axMap": "--ax-info" } }
      }
    },
    "dark": {
      "$type": "color",
      "$description": "Dark-mode semantic role counterparts. Each carries the same axMap as its light counterpart with scope:dark. Values match html.accrue-admin[data-theme='dark'] in theme.css exactly.",
      "base": {
        "$value": { "colorSpace": "srgb", "components": [0.059, 0.075, 0.094], "hex": "#0f1318" },
        "$type": "color",
        "$description": "Dark base surface — page background in dark mode.",
        "$extensions": { "org.accrue.ax": { "axMap": "--ax-base", "scope": "dark" } }
      },
      "elevated": {
        "$value": { "colorSpace": "srgb", "components": [0.090, 0.114, 0.141], "hex": "#171d24" },
        "$type": "color",
        "$description": "Dark elevated surface — cards, panels in dark mode.",
        "$extensions": { "org.accrue.ax": { "axMap": "--ax-elevated", "scope": "dark" } }
      },
      "sunken": {
        "$value": { "colorSpace": "srgb", "components": [0.043, 0.063, 0.082], "hex": "#0b1015" },
        "$type": "color",
        "$description": "Dark sunken surface — recessed wells in dark mode.",
        "$extensions": { "org.accrue.ax": { "axMap": "--ax-sunken", "scope": "dark" } }
      },
      "primary": {
        "$value": { "colorSpace": "srgb", "components": [0.957, 0.969, 0.980], "hex": "#f4f7fa" },
        "$type": "color",
        "$description": "Dark primary content — near-white text on dark backgrounds.",
        "$extensions": { "org.accrue.ax": { "axMap": "--ax-primary", "scope": "dark" } }
      },
      "muted": {
        "$value": { "colorSpace": "srgb", "components": [0.659, 0.698, 0.737], "hex": "#a8b2bc" },
        "$type": "color",
        "$description": "Dark muted content — secondary labels in dark mode.",
        "$extensions": { "org.accrue.ax": { "axMap": "--ax-muted", "scope": "dark" } }
      },
      "subtle": {
        "$value": { "colorSpace": "srgb", "components": [0.843, 0.867, 0.890], "hex": "#d7dde3" },
        "$type": "color",
        "$description": "Dark subtle content — borders, tertiary UI elements in dark mode.",
        "$extensions": { "org.accrue.ax": { "axMap": "--ax-subtle", "scope": "dark" } }
      },
      "info": {
        "$value": { "colorSpace": "srgb", "components": [0.290, 0.565, 0.722], "hex": "#4a90b8" },
        "$type": "color",
        "$description": "Dark info — slightly lighter teal-blue for dark backgrounds.",
        "$extensions": { "org.accrue.ax": { "axMap": "--ax-info", "scope": "dark" } }
      }
    },
    "code-block": {
      "$type": "color",
      "$description": "Code block brand tokens — new brand-layer definitions (D-09b). No upstream --ax-* counterpart; axMap:null. Values derived from the Fog/Slate/Ink neutral family. One-line PR ratification recommended.",
      "surface": {
        "$value": { "colorSpace": "srgb", "components": [0.914, 0.933, 0.949], "hex": "#e9eef2" },
        "$type": "color",
        "$description": "Code block background — equals Fog; a soft neutral that recedes behind code. Brand-only.",
        "$extensions": { "org.accrue.ax": { "axMap": null } }
      },
      "text": {
        "$value": { "colorSpace": "srgb", "components": [0.141, 0.188, 0.231], "hex": "#24303b" },
        "$type": "color",
        "$description": "Code block foreground — equals Slate; readable on Fog surface (AAA). Brand-only.",
        "$extensions": { "org.accrue.ax": { "axMap": null } }
      }
    },
    "callout": {
      "$type": "color",
      "$description": "Callout brand tokens — new brand-layer definitions (D-09b). Tinted neutral, distinct from code-block. No upstream --ax-* counterpart; axMap:null. One-line PR ratification recommended.",
      "surface": {
        "$value": { "colorSpace": "srgb", "components": [0.945, 0.961, 0.973], "hex": "#f1f5f8" },
        "$type": "color",
        "$description": "Callout background — equals Sunken; a warm-cool neutral for guide callout boxes. Brand-only.",
        "$extensions": { "org.accrue.ax": { "axMap": null } }
      },
      "text": {
        "$value": { "colorSpace": "srgb", "components": [0.067, 0.078, 0.094], "hex": "#111418" },
        "$type": "color",
        "$description": "Callout foreground — equals Ink; maximum contrast on callout surface (AAA). Brand-only.",
        "$extensions": { "org.accrue.ax": { "axMap": null } }
      }
    }
  },
  "dimension": {
    "$type": "dimension",
    "$description": "Reference-only dimension entries (D-11). Documents the --ax-* spacing scale without minting --accrue-space-* tokens. Not value-enforced by parity check.",
    "space": {
      "$description": "Spacing scale — 4px base. Reference-only; admin SSOT is --ax-space-*.",
      "2xs": {
        "$value": { "value": 0.125, "unit": "rem" },
        "$type": "dimension",
        "$description": "2px — dense table controls, hairline gaps.",
        "$extensions": { "org.accrue.ax": { "axMap": null, "referencesAx": "--ax-space-2xs" } }
      },
      "xs": {
        "$value": { "value": 0.25, "unit": "rem" },
        "$type": "dimension",
        "$description": "4px — tight internal padding, icon margins.",
        "$extensions": { "org.accrue.ax": { "axMap": null, "referencesAx": "--ax-space-xs" } }
      },
      "sm": {
        "$value": { "value": 0.5, "unit": "rem" },
        "$type": "dimension",
        "$description": "8px — compact component padding.",
        "$extensions": { "org.accrue.ax": { "axMap": null, "referencesAx": "--ax-space-sm" } }
      },
      "md": {
        "$value": { "value": 1, "unit": "rem" },
        "$type": "dimension",
        "$description": "16px — standard component padding, section gaps.",
        "$extensions": { "org.accrue.ax": { "axMap": null, "referencesAx": "--ax-space-md" } }
      },
      "lg": {
        "$value": { "value": 1.5, "unit": "rem" },
        "$type": "dimension",
        "$description": "24px — card padding, generous spacing.",
        "$extensions": { "org.accrue.ax": { "axMap": null, "referencesAx": "--ax-space-lg" } }
      },
      "xl": {
        "$value": { "value": 2, "unit": "rem" },
        "$type": "dimension",
        "$description": "32px — section padding, layout spacing.",
        "$extensions": { "org.accrue.ax": { "axMap": null, "referencesAx": "--ax-space-xl" } }
      },
      "2xl": {
        "$value": { "value": 3, "unit": "rem" },
        "$type": "dimension",
        "$description": "48px — page section separation.",
        "$extensions": { "org.accrue.ax": { "axMap": null, "referencesAx": "--ax-space-2xl" } }
      },
      "3xl": {
        "$value": { "value": 4, "unit": "rem" },
        "$type": "dimension",
        "$description": "64px — major layout divisions.",
        "$extensions": { "org.accrue.ax": { "axMap": null, "referencesAx": "--ax-space-3xl" } }
      }
    }
  }
}

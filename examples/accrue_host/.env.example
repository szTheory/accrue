# Copy to .env (gitignored) and adjust when running multiple demos at once.
# Cross-lib port convention: give each library's demo its own port block.
#   accrue:   web 4000     otherlib: web 4010     thirdlib: web 4020
ACCRUE_HOST_DOCKER_PORT=4000
ACCRUE_HOST_COMPOSE_PROJECT=accrue-host
# ACCRUE_HOST_DOCKER_BIND=127.0.0.1   # set 0.0.0.0 to reach the demo from other devices
# PGPORT=5432                          # only used by docker-compose.override.yml (DB GUI)

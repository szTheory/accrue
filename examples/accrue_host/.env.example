# Copy to .env (gitignored) and adjust as needed.
#
# By default each `make up` auto-picks a free ephemeral host port and the banner
# prints the live URL — you never have to pick a port, and two demos can never
# collide. Set ACCRUE_HOST_DOCKER_PORT below ONLY if you want a stable URL
# (e.g. for OAuth callbacks that need a fixed redirect).
#
# ACCRUE_HOST_DOCKER_PORT=4010   # opt-in: pin a fixed host port instead of ephemeral

# Needed to run two checkouts of THIS same lib side by side (isolates the
# Compose project name: separate networks, volumes, and container names).
ACCRUE_HOST_COMPOSE_PROJECT=accrue-host

# ACCRUE_HOST_DOCKER_BIND=127.0.0.1   # set 0.0.0.0 to reach the demo from other devices
# PGPORT=5432                          # only used by docker-compose.override.yml (DB GUI)

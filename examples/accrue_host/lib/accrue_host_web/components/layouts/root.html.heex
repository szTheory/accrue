<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default={AccrueHost.DemoBrand.product_name()} suffix="">
      {assigns[:page_title]}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      (() => {
        const setTheme = (theme) => {
          if (theme === "system") {
            localStorage.removeItem("phx:theme");
            document.documentElement.removeAttribute("data-theme");
          } else {
            localStorage.setItem("phx:theme", theme);
            document.documentElement.setAttribute("data-theme", theme);
          }
        };
        if (!document.documentElement.hasAttribute("data-theme")) {
          setTheme(localStorage.getItem("phx:theme") || "system");
        }
        window.addEventListener("storage", (e) => e.key === "phx:theme" && setTheme(e.newValue || "system"));
        
        window.addEventListener("phx:set-theme", (e) => setTheme(e.target.dataset.phxTheme));
      })();
    </script>
  </head>
  <body class="bg-base-100 text-base-content antialiased">
    <% current_user = assigns[:current_scope] && assigns.current_scope.user %>
    <% personas = AccrueHost.DemoBrand.personas() %>
    <% current_persona = current_user && Enum.find(personas, &(&1.email == current_user.email)) %>
    <header class="relative z-10 border-b border-base-300 bg-base-100/95">
      <nav class="mx-auto flex min-h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
        <.link href={~p"/"} class="flex min-w-0 items-center gap-3">
          <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-primary text-sm font-bold text-primary-content">
            CF
          </span>
          <span class="min-w-0">
            <span class="block truncate text-sm font-semibold">
              {AccrueHost.DemoBrand.product_name()}
            </span>
            <span class="hidden text-xs text-base-content/60 sm:block">
              Cohort operations
            </span>
          </span>
        </.link>

        <div class="flex min-w-0 items-center gap-2">
          <.link href={~p"/pricing"} class="btn btn-ghost btn-sm rounded-lg">
            Pricing
          </.link>
          <.theme_toggle />
          <%= if current_user do %>
            <.link
              href={~p"/app/billing"}
              class="btn btn-ghost btn-sm hidden rounded-lg sm:inline-flex"
            >
              Billing
            </.link>
            <div class="dropdown dropdown-end">
              <div
                tabindex="0"
                role="button"
                class="btn btn-ghost btn-sm rounded-lg"
                aria-haspopup="menu"
                aria-label="Switch demo account"
              >
                <.icon name="hero-users" class="size-4" />
                <span class="hidden max-w-40 truncate md:inline">
                  {(current_persona && current_persona.label) || "Switch account"}
                </span>
                <.icon name="hero-chevron-down" class="size-3 opacity-60" />
              </div>
              <ul
                tabindex="0"
                class="dropdown-content z-50 mt-2 w-64 rounded-box border border-base-300 bg-base-100 p-2 shadow-lg"
              >
                <li class="px-3 py-1 text-xs font-semibold uppercase text-base-content/45">
                  Switch demo account
                </li>
                <li :for={persona <- personas}>
                  <.demo_login_form persona={persona}>
                    <button
                      type="submit"
                      class={[
                        "flex w-full flex-col rounded-md px-3 py-2 text-left transition-colors hover:bg-base-200",
                        current_persona && current_persona.email == persona.email && "bg-base-200"
                      ]}
                    >
                      <span class="text-sm font-semibold">{persona.label}</span>
                      <span class="text-xs text-base-content/60">
                        {persona.workspace} · {persona.state}
                      </span>
                    </button>
                  </.demo_login_form>
                </li>
              </ul>
            </div>
            <.link
              href={~p"/users/settings"}
              class="btn btn-ghost btn-sm hidden rounded-lg sm:inline-flex"
            >
              Settings
            </.link>
            <.link
              href={~p"/users/log-out"}
              method="delete"
              class="btn btn-outline btn-sm rounded-lg"
            >
              Log out
            </.link>
          <% else %>
            <.link
              href={~p"/users/register"}
              class="btn btn-ghost btn-sm hidden rounded-lg sm:inline-flex"
            >
              Register
            </.link>
            <.link href={~p"/users/log-in"} class="btn btn-primary btn-sm rounded-lg">
              Log in
            </.link>
          <% end %>
        </div>
      </nav>
    </header>
    {@inner_content}
  </body>
</html>

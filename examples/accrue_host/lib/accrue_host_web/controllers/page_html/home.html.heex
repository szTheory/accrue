<% current_user = assigns[:current_scope] && assigns.current_scope.user %>
<% product_name = AccrueHost.DemoBrand.product_name() %>
<% tagline = AccrueHost.DemoBrand.tagline() %>
<% demo_password = AccrueHost.DemoBrand.demo_password() %>
<% primary_personas = Enum.take(@personas, 3) %>

<Layouts.flash_group flash={@flash} />

<div class="min-h-screen bg-base-100 text-base-content">
  <section class="border-b border-base-300 bg-base-100">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 lg:grid-cols-[minmax(0,1fr)_25rem] lg:px-8">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase text-primary">Team project tracking</p>
        <h1 class="mt-3 text-4xl font-semibold leading-tight text-base-content sm:text-5xl">
          {product_name}
        </h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-base-content/70">
          {tagline}
        </p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <.link href={~p"/pricing"} class="btn btn-primary rounded-lg">
            View pricing
          </.link>
          <.link href={~p"/users/log-in"} class="btn btn-outline rounded-lg">
            Sign in as team lead
          </.link>
          <.link href={~p"/admin"} class="btn btn-ghost rounded-lg">
            Open Accrue Admin
          </.link>
        </div>

        <p class="mt-5 text-sm text-base-content/60">
          {if current_user,
            do: "Signed in as #{current_user.email}.",
            else: "Seeded accounts use password #{demo_password}."}
        </p>
      </div>

      <aside class="rounded-lg border border-base-300 bg-base-200 p-5 shadow-sm">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="text-sm font-semibold text-base-content/60">Live project snapshot</p>
            <h2 class="mt-1 text-2xl font-semibold">Q3 Platform Roadmap</h2>
          </div>
          <span class="rounded-md bg-primary px-2 py-1 text-xs font-semibold text-primary-content">
            Studio
          </span>
        </div>

        <div class="mt-6 grid gap-3">
          <div class="flex items-center justify-between border-b border-base-300 pb-3">
            <span class="text-sm text-base-content/60">Active issues</span>
            <span class="text-lg font-semibold">148</span>
          </div>
          <div class="flex items-center justify-between border-b border-base-300 pb-3">
            <span class="text-sm text-base-content/60">Team seats</span>
            <span class="text-lg font-semibold">6</span>
          </div>
          <div class="flex items-center justify-between border-b border-base-300 pb-3">
            <span class="text-sm text-base-content/60">Next invoice</span>
            <span class="text-lg font-semibold">$30.00</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-sm text-base-content/60">Payment health</span>
            <span class="rounded-md bg-success px-2 py-1 text-xs font-semibold text-success-content">
              Current
            </span>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <main>
    <section class="bg-base-200">
      <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="text-sm font-semibold uppercase text-secondary">Evaluator paths</p>
            <h2 class="mt-2 text-2xl font-semibold">Three realistic billing roles</h2>
          </div>
          <p class="max-w-xl text-sm leading-6 text-base-content/65">
            Start from a product role, then move between workspace billing, the customer portal, and the operator console.
          </p>
        </div>

        <div class="mt-7 grid gap-4 lg:grid-cols-3">
          <article
            :for={persona <- primary_personas}
            class="rounded-lg border border-base-300 bg-base-100 p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
          >
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="text-xs font-semibold uppercase text-base-content/50">
                  {persona.state}
                </p>
                <h3 class="mt-2 text-xl font-semibold">{persona.label}</h3>
              </div>
              <span class="rounded-md border border-base-300 px-2 py-1 text-xs font-semibold text-base-content/60">
                {persona.workspace}
              </span>
            </div>
            <p class="mt-4 min-h-24 text-sm leading-6 text-base-content/65">
              {persona.description}
            </p>
            <div class="mt-5 rounded-md bg-base-200 px-3 py-2 text-sm">
              <p class="font-semibold">{persona.email}</p>
              <p class="text-base-content/60">{demo_password}</p>
            </div>
            <.link href={persona.route} class="btn btn-sm btn-outline mt-5 rounded-lg">
              Open path
            </.link>
          </article>
        </div>
      </div>
    </section>

    <section class="border-y border-base-300 bg-base-100">
      <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-8 sm:px-6 lg:flex-row lg:items-center lg:justify-between lg:px-8">
        <div>
          <p class="text-sm font-semibold text-base-content/60">
            Customer-facing billing uses Cadence. Operator billing uses Accrue Admin.
          </p>
          <h2 class="mt-1 text-xl font-semibold">
            The brand split mirrors a real Phoenix SaaS using a mounted billing library.
          </h2>
        </div>

        <div class="flex flex-col gap-3 sm:flex-row">
          <.link
            href={~p"/app/billing"}
            class="btn btn-secondary rounded-lg"
            data-testid="workspace-billing-link"
          >
            Workspace billing
          </.link>
          <.link href={~p"/billing"} class="btn btn-outline rounded-lg">
            Customer portal
          </.link>
        </div>
      </div>
    </section>

    <section class="bg-base-200">
      <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
        <details class="rounded-lg border border-base-300 bg-base-100 p-5">
          <summary class="cursor-pointer text-sm font-semibold">
            Developer routes
          </summary>
          <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            <.link
              href={~p"/billing/payment-methods"}
              class="rounded-md border border-base-300 p-3 text-sm hover:bg-base-200"
            >
              Portal payment methods
            </.link>
            <.link
              href={~p"/billing/invoices"}
              class="rounded-md border border-base-300 p-3 text-sm hover:bg-base-200"
            >
              Portal invoices
            </.link>
            <.link
              href={~p"/admin/webhooks"}
              class="rounded-md border border-base-300 p-3 text-sm hover:bg-base-200"
            >
              Webhook events
            </.link>
            <.link
              href={~p"/admin/analytics/recovery"}
              class="rounded-md border border-base-300 p-3 text-sm hover:bg-base-200"
            >
              Recovery analytics
            </.link>
            <.link
              href={~p"/app/reports/advanced"}
              class="rounded-md border border-base-300 p-3 text-sm hover:bg-base-200"
            >
              Entitled report
            </.link>
            <.link
              href="/dev/mailbox"
              class="rounded-md border border-base-300 p-3 text-sm hover:bg-base-200"
            >
              Dev mailbox
            </.link>
          </div>
        </details>
      </div>
    </section>
  </main>
</div>

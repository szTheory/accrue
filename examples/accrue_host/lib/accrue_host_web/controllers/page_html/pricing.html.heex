<% current_user = assigns[:current_scope] && assigns.current_scope.user %>
<% product_name = AccrueHost.DemoBrand.product_name() %>

<Layouts.flash_group flash={@flash} />

<div class="min-h-screen bg-base-100 text-base-content">
  <section class="border-b border-base-300 bg-base-100">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase text-primary">{product_name} pricing</p>
        <h1 class="mt-3 text-4xl font-semibold leading-tight sm:text-5xl">
          Plans for cohort programs that charge real money.
        </h1>
        <p class="mt-5 text-lg leading-8 text-base-content/70">
          Pick the workspace tier that matches your cohort operation, then manage subscription state from the app or customer portal.
        </p>
      </div>
    </div>
  </section>

  <main>
    <section class="bg-base-200">
      <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
        <div class="grid gap-4 lg:grid-cols-3">
          <article
            :for={plan <- @plans}
            class={[
              "rounded-lg border bg-base-100 p-6 shadow-sm",
              if(plan[:featured],
                do: "border-primary ring-2 ring-primary/20",
                else: "border-base-300"
              )
            ]}
            data-plan-id={plan.id}
          >
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="text-sm font-semibold uppercase text-base-content/50">
                  {plan.eyebrow}
                </p>
                <h2 class="mt-2 text-2xl font-semibold">{plan.label}</h2>
              </div>
              <span
                :if={plan[:featured]}
                class="rounded-md bg-primary px-2 py-1 text-xs font-semibold text-primary-content"
              >
                Popular
              </span>
            </div>

            <p class="mt-5 text-4xl font-semibold">{plan_price(plan)}</p>
            <p class="mt-1 text-sm text-base-content/60">{plan_interval(plan)}</p>
            <p class="mt-5 min-h-20 text-sm leading-6 text-base-content/65">
              {plan_blurb(plan)}
            </p>

            <ul class="mt-5 space-y-3 text-sm leading-6">
              <li :for={feature <- plan_features(plan)} class="flex gap-2">
                <.icon name="hero-check-circle" class="mt-0.5 size-5 shrink-0 text-primary" />
                <span>{feature}</span>
              </li>
            </ul>

            <.link href={~p"/users/log-in"} class="btn btn-primary btn-block mt-6 rounded-lg">
              Choose {plan.label}
            </.link>
          </article>
        </div>
      </div>
    </section>

    <section class="border-t border-base-300 bg-base-100">
      <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-8 sm:px-6 lg:flex-row lg:items-center lg:justify-between lg:px-8">
        <div>
          <p class="text-sm font-semibold text-base-content/60">
            {if current_user,
              do: "Signed in as #{current_user.email}",
              else: "No account required to review pricing"}
          </p>
          <h2 class="mt-1 text-xl font-semibold">
            Continue to a protected billing flow when you want to work with subscription state.
          </h2>
        </div>

        <div class="flex flex-col gap-3 sm:flex-row">
          <.link href={~p"/app/billing"} class="btn btn-secondary rounded-lg">
            Workspace billing
          </.link>
          <.link href={~p"/billing"} class="btn btn-outline rounded-lg">
            Customer portal
          </.link>
        </div>
      </div>
    </section>
  </main>
</div>

{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": false,
  "include-component-in-tag": true,
  "commit-search-depth": 2000,
  "group-pull-request-title-pattern": "chore: release accrue-monorepo ${version}",
  "plugins": [
    {
      "type": "linked-versions",
      "groupName": "accrue-monorepo",
      "components": ["accrue", "accrue_admin", "accrue_portal"]
    }
  ],
  "packages": {
    "accrue": {
      "component": "accrue",
      "release-type": "elixir",
      "package-name": "accrue",
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": true
    },
    "accrue_admin": {
      "component": "accrue_admin",
      "release-type": "elixir",
      "package-name": "accrue_admin",
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": true
    },
    "accrue_portal": {
      "component": "accrue_portal",
      "release-type": "elixir",
      "package-name": "accrue_portal",
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": true
    }
  }
}
